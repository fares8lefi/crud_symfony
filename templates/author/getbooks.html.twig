{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# titre et bouton d'ajout #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-2" style="color: #2d3748;">
                <i class="bi bi-book-half text-primary"></i>
                Bibliothèque
            </h1>
            <p class="text-muted mb-0">Gérez votre collection de livres</p>
        </div>
        <a href="{{ path('app_addBook') }}" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Ajouter un livre
        </a>
    </div>

    {# Messages de succès #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row g-4">
        {% for book in books %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-3 text-dark">{{ book.title }}</h5>
                        
                        {# Informations #}
                        <div class="mb-3 flex-grow-1">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-person-fill text-primary me-2"></i>
                                <small class="text-muted">{{ book.author.name }}</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-event text-primary me-2"></i>
                                <small class="text-muted">{{ book.publishedAt|date('d/m/Y') }}</small>
                            </div>
                        </div>

                        {# Boutons d'action #}
                        <div class="d-flex gap-2 mt-auto">
                            <a href="{{ path('app_editBook', {'id': book.id}) }}" 
                               class="btn btn-outline-warning btn-sm flex-fill">
                                <i class="bi bi-pencil-square"></i>
                                Modifier
                            </a>
                            <a href="{{ path('app_deleteBook', {'id': book.id}) }}"
                               class="btn btn-outline-danger btn-sm flex-fill"
                               onclick="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer « {{ book.title }} » ?');">
                                <i class="bi bi-trash"></i>
                                Supprimer
                            </a>
                        </div>
                    </div>

                    {# Footer optionnel pour description #}
                    {% if book.description %}
                        <div class="card-footer bg-light border-0 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            {{ book.description|length > 80 ? book.description|slice(0, 80) ~ '...' : book.description }}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            {# État vide #}
            <div class="col-12">
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                        <h4 class="text-muted mb-3">Aucun livre trouvé</h4>
                        <p class="text-muted mb-4">Commencez par ajouter votre premier livre à la collection</p>
                        <a href="{{ path('app_addBook') }}" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Ajouter un livre
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }
    
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
    
    .card {
        border-radius: 12px;
        overflow: hidden;
    }
    
    .btn {
        transition: all 0.2s ease;
    }
    
    .btn:hover {
        transform: scale(1.02);
    }
    
    .badge {
        font-weight: 500;
    }
    
    .card-footer {
        font-size: 0.85rem;
        line-height: 1.4;
    }
</style>
{% endblock %}